<!DOCTYPE html>
{# nexterp-gen-addon-index-html — DO NOT EDIT; regenerated by oca-gen-addon-readme --html-template-filename.

   apps.odoo.com sanitization rules we honour:
   - no <style> tag (would be stripped)
   - no <script> / no <input> / no <iframe>
   - only Bootstrap 4 classes for layout
   - inline styles limited to color, font-*, margin-*, padding-*, border-*
   - external links restricted (we only link to apps.odoo.com / nexterp.ro / mailto)

   Local-only previews keep working because Bootstrap is loaded by the
   apps.odoo.com chrome that wraps this body; opening the file at
   file:// shows the same content without bootstrap styling, which is
   acceptable since this template targets the store page.
-#}
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="generator" content="{{ marker }}" />
<title>{{ manifest.name }}</title>
{# apps.odoo.com loads its own Bootstrap 5 chrome around this body; the
   CDN <link>/<script> below only matter for file:// previews and are
   harmless on the store page (the platform either strips them or
   resolves to the same version). #}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" defer></script>
</head>
<body>

<div class="container py-4" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">

  {# ===== Hero ===== #}
  <div class="card mb-4 border-0" style="border-left: 6px solid #e11d48; padding: 24px;">
    <div class="row align-items-center">
      <div class="col-md-2 text-center mb-3 mb-md-0">
        {% if icon %}
        <img src="{{ icon }}" alt="{{ manifest.name }} icon" class="img-fluid rounded" style="max-width: 128px; padding: 4px;" />
        {% else %}
        <div class="d-flex align-items-center justify-content-center text-white font-weight-bold rounded mx-auto" style="width: 128px; height: 128px; font-size: 36px; background-color: #e11d48;">{{ manifest.name[:2]|upper }}</div>
        {% endif %}
      </div>
      <div class="col-md-10">
        <h1 class="mb-2" style="font-weight: 700;">{{ manifest.name }}</h1>
        {% if manifest.summary %}
        <p class="lead text-muted mb-3">{{ manifest.summary|trim }}</p>
        {% endif %}
        <div>
          <span class="badge badge-pill text-white mr-2" style="background-color: #e11d48; padding: 6px 14px; font-size: 13px;">v {{ manifest.version or branch }}</span>
          {% if manifest.category %}<span class="badge badge-pill badge-light mr-2 border" style="padding: 6px 14px; font-size: 13px;">{{ manifest.category }}</span>{% endif %}
          {% if manifest.license %}<span class="badge badge-pill badge-light border" style="padding: 6px 14px; font-size: 13px;">{{ manifest.license }}</span>{% endif %}
        </div>
      </div>
    </div>
  </div>

  {# ===== Tab nav (Bootstrap 5 pills — apps.odoo.com loads BS5 JS,
       so data-bs-toggle="pill" handles the switching for free).

       Critical: inline styles must be SYMMETRIC across all tabs.
       Bootstrap's JS toggles the ``active`` class on click; inline
       styles do NOT toggle, so a per-loop conditional style would
       leave the first tab visually "active" forever even after the
       user picks another one. We therefore put only structural inline
       styles (border, padding, font-weight) on every link and let
       Bootstrap paint the active state via its default
       ``.nav-link.active`` rule (white text + brand-blue background). #}
  <ul class="nav nav-pills justify-content-center mb-4 pb-3 border-bottom" role="tablist">
    {% set label_map = {'overview': 'Overview', 'features': 'Features', 'configure': 'Configuration', 'usage': 'How it works', 'screenshots': 'Screenshots', 'versions': 'Versions'} %}
    {% for tid in tab_ids %}
    <li class="nav-item mx-1 mb-2" role="presentation">
      <a class="nav-link{% if loop.first %} active{% endif %}" id="nx-tab-{{ tid }}" data-bs-toggle="pill" data-bs-target="#nx-panel-{{ tid }}" href="#nx-panel-{{ tid }}" role="tab" aria-controls="nx-panel-{{ tid }}" aria-selected="{{ 'true' if loop.first else 'false' }}" style="font-weight: 600; padding: 10px 22px; border: 1px solid #e2e8f0; border-radius: 999px;">{{ label_map[tid] }}</a>
    </li>
    {% endfor %}
  </ul>

  {# ===== Tab panels ===== #}
  <div class="tab-content">

    {% if 'overview' in tab_ids %}
    <div class="tab-pane fade{% if tab_ids[0] == 'overview' %} show active{% endif %}" id="nx-panel-overview" role="tabpanel" aria-labelledby="nx-tab-overview">
      <h2 class="mb-3 pl-3" style="border-left: 4px solid #e11d48; font-weight: 700; padding-left: 16px;">Overview</h2>
      <div>
        {% if fragments.DESCRIPTION %}
        {{ fragments.DESCRIPTION.body }}
        {% elif fragments.CONTEXT %}
        {{ fragments.CONTEXT.body }}
        {% endif %}
      </div>
      {% if nexterp_presentation %}
      <hr class="my-4" />
      {# Built & supported banner #}
      <div class="row align-items-center text-white rounded p-4 mx-0 mb-4" style="background-color: #0f172a;">
        {% if nexterp_logo %}
        <div class="col-md-3 text-center mb-3 mb-md-0">
          <div class="bg-white rounded p-2 d-inline-block">
            <img src="{{ nexterp_logo }}" alt="NextERP Romania" class="img-fluid" style="max-width: 140px;" />
          </div>
        </div>
        <div class="col-md-9">
        {% else %}
        <div class="col-12">
        {% endif %}
          <h3 class="text-white mb-2" style="font-weight: 700;">Built &amp; supported by NextERP Romania</h3>
          <p class="mb-0" style="color: #cbd5e1;">Romanian Odoo specialists, here for the long run — from implementation to localization and day-to-day production support.</p>
        </div>
      </div>
      {{ nexterp_presentation }}
      {% endif %}
    </div>
    {% endif %}

    {% if 'features' in tab_ids %}
    <div class="tab-pane fade{% if tab_ids[0] == 'features' %} show active{% endif %}" id="nx-panel-features" role="tabpanel" aria-labelledby="nx-tab-features">
      <h2 class="mb-3" style="border-left: 4px solid #e11d48; font-weight: 700; padding-left: 16px;">Features</h2>
      {{ fragments.CONTEXT.body }}
    </div>
    {% endif %}

    {% if 'configure' in tab_ids %}
    <div class="tab-pane fade{% if tab_ids[0] == 'configure' %} show active{% endif %}" id="nx-panel-configure" role="tabpanel" aria-labelledby="nx-tab-configure">
      <h2 class="mb-3" style="border-left: 4px solid #e11d48; font-weight: 700; padding-left: 16px;">Configuration</h2>
      {% if fragments.CONFIGURE %}
      {{ fragments.CONFIGURE.body }}
      {% endif %}
      {% if fragments.INSTALL %}
      {% if fragments.CONFIGURE %}<hr class="my-4" />{% endif %}
      {% if fragments.INSTALL.title %}<h3>{{ fragments.INSTALL.title }}</h3>{% endif %}
      {{ fragments.INSTALL.body }}
      {% endif %}
    </div>
    {% endif %}

    {% if 'usage' in tab_ids %}
    <div class="tab-pane fade{% if tab_ids[0] == 'usage' %} show active{% endif %}" id="nx-panel-usage" role="tabpanel" aria-labelledby="nx-tab-usage">
      <h2 class="mb-3" style="border-left: 4px solid #e11d48; font-weight: 700; padding-left: 16px;">How it works</h2>
      {{ fragments.USAGE.body }}
    </div>
    {% endif %}

    {% if 'screenshots' in tab_ids %}
    <div class="tab-pane fade{% if tab_ids[0] == 'screenshots' %} show active{% endif %}" id="nx-panel-screenshots" role="tabpanel" aria-labelledby="nx-tab-screenshots">
      <h2 class="mb-3" style="border-left: 4px solid #e11d48; font-weight: 700; padding-left: 16px;">Screenshots</h2>
      <p class="text-muted mb-3">Captured from a running Odoo instance.</p>
      <div class="row">
        {% for shot in gallery %}
        <div class="col-md-6 mb-3">
          <div class="card h-100 border">
            <a href="{{ shot.filename }}" target="_blank" rel="noopener">
              <img src="{{ shot.filename }}" alt="{{ shot.caption }}" class="card-img-top" />
            </a>
            <div class="card-body py-2">
              <p class="card-text mb-0" style="font-size: 14px;">{{ shot.caption }}</p>
            </div>
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {% if 'versions' in tab_ids %}
    <div class="tab-pane fade{% if tab_ids[0] == 'versions' %} show active{% endif %}" id="nx-panel-versions" role="tabpanel" aria-labelledby="nx-tab-versions">
      <h2 class="mb-3" style="border-left: 4px solid #e11d48; font-weight: 700; padding-left: 16px;">Versions</h2>
      {{ fragments.HISTORY.body }}
    </div>
    {% endif %}

  </div>

  {# ===== Suite section: other modules in this repo ===== #}
  {% if siblings %}
  <section class="bg-light rounded p-4 mb-4 border">
    <h2 class="text-center mb-2" style="font-weight: 700;">Discover the NextERP suite</h2>
    <p class="text-center text-muted mb-4">Other modules from the same publisher, built to work together.</p>
    <div class="row">
      {% for s in siblings %}
      <div class="col-md-3 col-sm-6 mb-3">
        <a href="{{ s.apps_url }}" target="_blank" rel="noopener" class="card h-100 text-decoration-none border" style="color: #0f172a;">
          <div class="card-body p-3">
            <div class="d-flex align-items-center mb-2">
              <div class="d-flex align-items-center justify-content-center text-white font-weight-bold rounded mr-3" style="width: 40px; height: 40px; font-size: 14px; background-color: #e11d48; flex-shrink: 0;">{{ s.title[:2]|upper }}</div>
              <div>
                <div style="font-weight: 600; font-size: 14px; line-height: 1.2;">{{ s.title }}</div>
                {% if s.category %}<div class="text-muted" style="font-size: 11px; margin-top: 2px;">{{ s.category }}</div>{% endif %}
              </div>
            </div>
            {% if s.summary %}<p class="text-muted mb-0" style="font-size: 12px;">{{ s.summary }}</p>{% endif %}
          </div>
        </a>
      </div>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {# ===== Brand footer ===== #}
  <div class="rounded p-4 text-white" style="background-color: #0f172a;">
    <div class="row align-items-center">
      <div class="col-md-8">
        <h4 class="text-white mb-1" style="font-weight: 700;">NextERP Romania</h4>
        <p class="mb-0" style="color: #cbd5e1;">Odoo implementation, customization, Romanian localization and long-term support since 2018.</p>
      </div>
      <div class="col-md-4 text-md-right mt-3 mt-md-0">
        <a href="https://www.nexterp.ro" target="_blank" rel="noopener" class="d-inline-block mb-2" style="color: #fda4af;">nexterp.ro</a><br />
        <a href="https://apps.odoo.com/apps/browse?author=NextERP+Romania" target="_blank" rel="noopener" style="color: #fda4af;">All apps</a>
      </div>
    </div>
  </div>

</div>

</body>
</html>
