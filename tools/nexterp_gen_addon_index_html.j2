<!DOCTYPE html>
{# nexterp-gen-addon-index-html — DO NOT EDIT; regenerated by oca-gen-addon-readme --html-template-filename. -#}
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="generator" content="{{ marker }}" />
<title>{{ manifest.name }}</title>
<style>
/* === NextERP branded apps.odoo.com presentation === */
:root {
  --nx-primary: #e11d48;
  --nx-primary-dark: #be123c;
  --nx-accent: #7c3aed;
  --nx-ink: #0f172a;
  --nx-muted: #475569;
  --nx-soft: #f8fafc;
  --nx-border: #e2e8f0;
  --nx-success: #16a34a;
  --nx-warning: #f59e0b;
  --nx-radius: 12px;
  --nx-radius-sm: 8px;
  --nx-shadow: 0 1px 2px rgba(15,23,42,.06), 0 8px 24px rgba(15,23,42,.06);
}

.nx-wrap, .nx-wrap *, .nx-wrap *::before, .nx-wrap *::after { box-sizing: border-box; }
.nx-wrap {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen-Sans, Ubuntu, Cantarell, "Helvetica Neue", sans-serif;
  color: var(--nx-ink);
  line-height: 1.55;
  font-size: 16px;
  max-width: 1180px;
  margin: 0 auto;
  padding: 0 16px 48px;
}
.nx-wrap h1, .nx-wrap h2, .nx-wrap h3, .nx-wrap h4 { color: var(--nx-ink); line-height: 1.25; margin: 0 0 .6em; }
.nx-wrap h2 { font-size: 1.5rem; font-weight: 700; }
.nx-wrap h3 { font-size: 1.2rem; font-weight: 700; margin-top: 1.4em; }
.nx-wrap h4 { font-size: 1.05rem; font-weight: 600; }
.nx-wrap p { margin: 0 0 1em; }
.nx-wrap a { color: var(--nx-primary-dark); text-decoration: none; }
.nx-wrap a:hover { text-decoration: underline; }
.nx-wrap img { max-width: 100%; height: auto; border-radius: var(--nx-radius-sm); }
.nx-wrap ul, .nx-wrap ol { padding-left: 1.4em; margin: 0 0 1em; }
.nx-wrap li { margin: .25em 0; }
.nx-wrap code { background: var(--nx-soft); padding: 1px 6px; border-radius: 4px; font-size: .9em; }
.nx-wrap blockquote { border-left: 3px solid var(--nx-primary); padding-left: 1em; color: var(--nx-muted); margin: 1em 0; }
.nx-wrap table { width: 100%; border-collapse: collapse; margin: 1em 0; }
.nx-wrap th, .nx-wrap td { padding: .55em .75em; border-bottom: 1px solid var(--nx-border); text-align: left; }
.nx-wrap th { background: var(--nx-soft); font-weight: 600; }

/* ----- Hero ----- */
.nx-hero {
  display: grid;
  grid-template-columns: 128px 1fr;
  gap: 24px;
  align-items: center;
  padding: 28px 28px;
  background: linear-gradient(135deg, #fff 0%, #fef2f2 100%);
  border: 1px solid var(--nx-border);
  border-radius: var(--nx-radius);
  margin: 24px 0;
  box-shadow: var(--nx-shadow);
}
.nx-divider {
  margin: 32px 0 24px;
  border: 0; height: 1px;
  background: linear-gradient(to right, transparent, var(--nx-border), transparent);
}
.nx-section-eyebrow {
  font-size: .75rem; font-weight: 700; letter-spacing: .08em;
  text-transform: uppercase; color: var(--nx-primary);
  margin: 0 0 8px;
}
.nx-hero__icon img { width: 128px; height: 128px; border-radius: 24px; box-shadow: var(--nx-shadow); }
.nx-hero__icon--placeholder {
  width: 128px; height: 128px; border-radius: 24px;
  background: linear-gradient(135deg, var(--nx-primary), var(--nx-accent));
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-weight: 700; font-size: 2.4rem;
  box-shadow: var(--nx-shadow);
}
.nx-hero__title { font-size: 1.9rem; font-weight: 700; margin: 0 0 6px; line-height: 1.15; }
.nx-hero__summary { font-size: 1.05rem; color: var(--nx-muted); margin: 0 0 12px; }
.nx-hero__meta { display: flex; flex-wrap: wrap; gap: 8px; }
.nx-badge {
  display: inline-flex; align-items: center; gap: 6px;
  font-size: .82rem; padding: 4px 10px; border-radius: 999px;
  background: #fff; border: 1px solid var(--nx-border); color: var(--nx-muted);
}
.nx-badge--brand { background: var(--nx-primary); color: #fff; border-color: var(--nx-primary); }
.nx-badge--success { background: var(--nx-success); color: #fff; border-color: var(--nx-success); }
.nx-badge--mature { background: #ecfdf5; color: #065f46; border-color: #a7f3d0; }
.nx-badge--beta { background: #fef3c7; color: #92400e; border-color: #fde68a; }

/* ----- Tabs (CSS only, radio + sibling selector) ----- */
.nx-tabs { margin: 24px 0; }
.nx-tabs input[type="radio"] { position: absolute; opacity: 0; pointer-events: none; }
.nx-tabs__nav {
  display: flex; flex-wrap: wrap; gap: 4px;
  border-bottom: 2px solid var(--nx-border);
  margin-bottom: 24px;
  position: sticky; top: 0; background: #fff; z-index: 5;
  padding-top: 8px;
}
.nx-tabs__nav label {
  cursor: pointer;
  padding: 10px 20px;
  font-weight: 600;
  color: var(--nx-muted);
  border-bottom: 3px solid transparent;
  margin-bottom: -2px;
  transition: color .15s, border-color .15s;
  user-select: none;
}
.nx-tabs__nav label:hover { color: var(--nx-ink); }
.nx-tabs__panel { display: none; animation: nx-fade .25s ease-out; }
@keyframes nx-fade { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }

{% for tid in tab_ids %}
#nx-tab-{{ tid }}:checked ~ .nx-tabs__nav label[for="nx-tab-{{ tid }}"] {
  color: var(--nx-primary);
  border-bottom-color: var(--nx-primary);
}
#nx-tab-{{ tid }}:checked ~ .nx-tabs__panels #nx-panel-{{ tid }} { display: block; }
{% endfor %}

/* ----- Suite section ----- */
.nx-suite {
  margin-top: 48px;
  padding: 32px 28px;
  background: var(--nx-soft);
  border-radius: var(--nx-radius);
  border: 1px solid var(--nx-border);
}
.nx-suite h2 { text-align: center; margin-bottom: 8px; }
.nx-suite__sub { text-align: center; color: var(--nx-muted); margin-bottom: 24px; }
.nx-suite__grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 16px;
}
.nx-suite__card {
  background: #fff;
  border: 1px solid var(--nx-border);
  border-radius: var(--nx-radius-sm);
  padding: 16px;
  display: flex; flex-direction: column; gap: 10px;
  text-decoration: none !important;
  color: var(--nx-ink);
  transition: transform .15s, box-shadow .15s, border-color .15s;
}
.nx-suite__card:hover { transform: translateY(-2px); box-shadow: var(--nx-shadow); border-color: var(--nx-primary); }
.nx-suite__card-head { display: flex; align-items: center; gap: 12px; }
.nx-suite__card-icon { width: 48px; height: 48px; border-radius: 10px; flex-shrink: 0; }
.nx-suite__card-icon--placeholder {
  background: linear-gradient(135deg, var(--nx-primary), var(--nx-accent));
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-weight: 700;
}
.nx-suite__card-title { font-weight: 600; font-size: .95rem; line-height: 1.25; }
.nx-suite__card-cat { font-size: .75rem; color: var(--nx-muted); margin-top: 2px; }
.nx-suite__card-summary { font-size: .85rem; color: var(--nx-muted); line-height: 1.45; }

/* ----- Brand footer ----- */
.nx-foot {
  margin-top: 48px;
  padding: 28px;
  background: var(--nx-ink);
  color: #fff;
  border-radius: var(--nx-radius);
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 24px;
  align-items: center;
}
.nx-foot h3 { color: #fff; margin: 0 0 6px; }
.nx-foot p { color: #cbd5e1; margin: 0; }
.nx-foot a { color: #fda4af; }
.nx-foot__links { display: flex; gap: 16px; flex-wrap: wrap; }

/* ----- Feature cards (auto-styled lists inside CONTEXT) ----- */
.nx-feature-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 16px;
  margin: 16px 0;
}
.nx-feature-grid > * { background: var(--nx-soft); padding: 16px; border-radius: var(--nx-radius-sm); border: 1px solid var(--nx-border); }

/* ----- Versions tab (HISTORY.md rendered) ----- */
.nx-versions h2 {
  margin: 0 0 .6em;
  padding: 6px 14px;
  background: linear-gradient(135deg, var(--nx-primary), var(--nx-accent));
  color: #fff;
  border-radius: 999px;
  display: inline-block;
  font-size: 1rem;
  letter-spacing: .02em;
}
.nx-versions h2 + h2 { margin-top: 2rem; }
.nx-versions h3, .nx-versions h4 { display: none; }
.nx-versions ul {
  list-style: none; padding: 0; margin: .8em 0 1.6em;
  border-left: 2px solid var(--nx-border);
  padding-left: 16px;
}
.nx-versions li {
  position: relative; padding: 6px 0 6px 4px;
  font-size: .95rem;
}
.nx-versions li::before {
  content: ""; position: absolute; left: -22px; top: 14px;
  width: 8px; height: 8px; border-radius: 50%;
  background: var(--nx-primary);
}
.nx-versions code, .nx-versions li > code:first-child {
  background: var(--nx-soft);
  color: var(--nx-primary-dark);
  font-size: .82em;
  padding: 1px 6px;
}

/* ----- Brand presentation (Overview tab, lower half) ----- */
.nx-brand-lead {
  display: grid;
  grid-template-columns: 1fr;
  gap: 18px;
  padding: 28px;
  margin: 0 0 24px;
  background: linear-gradient(135deg, var(--nx-ink) 0%, #1e293b 100%);
  color: #fff;
  border-radius: var(--nx-radius);
}
.nx-brand-lead h2 { color: #fff; margin: 0; font-size: 1.5rem; }
.nx-brand-lead p { color: #cbd5e1; margin: 0; }
.nx-brand-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  margin: 8px 0 24px;
}
.nx-brand-stat {
  text-align: center;
  padding: 18px 12px;
  background: #fff;
  border: 1px solid var(--nx-border);
  border-radius: var(--nx-radius-sm);
}
.nx-brand-stat__num { font-size: 2rem; font-weight: 800; color: var(--nx-primary); line-height: 1.1; }
.nx-brand-stat__lbl { font-size: .85rem; color: var(--nx-muted); margin-top: 6px; }
.nx-brand-cards {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  margin: 16px 0;
}
.nx-brand-card {
  padding: 22px 18px;
  background: var(--nx-soft);
  border: 1px solid var(--nx-border);
  border-radius: var(--nx-radius-sm);
  display: flex; flex-direction: column; gap: 10px;
  transition: transform .15s, box-shadow .15s, border-color .15s;
  text-decoration: none !important;
  color: var(--nx-ink) !important;
}
.nx-brand-card:hover { transform: translateY(-2px); border-color: var(--nx-primary); box-shadow: var(--nx-shadow); }
.nx-brand-card:hover .nx-brand-card__title { color: var(--nx-primary); }
.nx-brand-card__ico {
  width: 48px; height: 48px; border-radius: 12px;
  display: flex; align-items: center; justify-content: center;
  font-size: 1.6rem;
  background: linear-gradient(135deg, var(--nx-primary), var(--nx-accent));
  color: #fff;
}
.nx-brand-card__title { font-weight: 700; font-size: 1.05rem; margin: 0; }
.nx-brand-card__desc { font-size: .92rem; color: var(--nx-muted); margin: 0; line-height: 1.5; }
.nx-brand-contact {
  display: flex; flex-wrap: wrap; gap: 12px; justify-content: center;
  margin: 24px 0 0;
}
.nx-brand-contact a {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 10px 18px;
  background: #fff; border: 1px solid var(--nx-border);
  border-radius: 999px;
  font-weight: 600; font-size: .9rem;
  color: var(--nx-ink) !important;
  text-decoration: none !important;
  transition: border-color .15s, color .15s;
}
.nx-brand-contact a:hover { border-color: var(--nx-primary); color: var(--nx-primary) !important; }
.nx-brand-contact__ico { font-size: 1.1rem; }
@media (max-width: 720px) {
  .nx-brand-stats, .nx-brand-cards { grid-template-columns: 1fr; }
}

/* ----- Responsive ----- */
@media (max-width: 720px) {
  .nx-hero { grid-template-columns: 80px 1fr; }
  .nx-hero__icon img, .nx-hero__icon--placeholder { width: 80px; height: 80px; border-radius: 16px; font-size: 1.6rem; }
  .nx-hero__title { font-size: 1.4rem; }
  .nx-foot { grid-template-columns: 1fr; }
  .nx-tabs__nav { overflow-x: auto; flex-wrap: nowrap; }
  .nx-tabs__nav label { white-space: nowrap; padding: 8px 14px; font-size: .9rem; }
}
</style>
</head>
<body>
<div class="nx-wrap">

  {# ===== Hero ===== #}
  <section class="nx-hero">
    <div class="nx-hero__icon">
      {% if icon %}
      <img src="{{ icon }}" alt="{{ manifest.name }} icon" />
      {% else %}
      <div class="nx-hero__icon--placeholder">{{ manifest.name[:2]|upper }}</div>
      {% endif %}
    </div>
    <div class="nx-hero__body">
      <h1 class="nx-hero__title">{{ manifest.name }}</h1>
      {% if manifest.summary %}
      <p class="nx-hero__summary">{{ manifest.summary|trim }}</p>
      {% endif %}
      <div class="nx-hero__meta">
        <span class="nx-badge nx-badge--brand">v {{ manifest.version or branch }}</span>
        {% if manifest.category %}<span class="nx-badge">{{ manifest.category }}</span>{% endif %}
        {% if manifest.license %}<span class="nx-badge">{{ manifest.license }}</span>{% endif %}
        {% set dev = (manifest.development_status or 'Beta')|lower %}
        {% if dev == 'mature' %}
        <span class="nx-badge nx-badge--mature">● Mature</span>
        {% elif dev in ('production/stable', 'production') %}
        <span class="nx-badge nx-badge--success">● Stable</span>
        {% elif dev == 'beta' %}
        <span class="nx-badge nx-badge--beta">● Beta</span>
        {% else %}
        <span class="nx-badge">● {{ manifest.development_status }}</span>
        {% endif %}
      </div>
    </div>
  </section>

  {# ===== Tabs ===== #}
  <section class="nx-tabs">
    {# Radios first, so :checked ~ siblings can target nav labels and panels. #}
    {% for tid in tab_ids %}
    <input type="radio" id="nx-tab-{{ tid }}" name="nx-tab"{% if loop.first %} checked{% endif %} />
    {% endfor %}

    <nav class="nx-tabs__nav" role="tablist">
      {% for tid in tab_ids %}
      {% set label_map = {'overview': 'Overview', 'features': 'Features', 'configure': 'Configuration', 'usage': 'How it works', 'versions': 'Versions'} %}
      <label for="nx-tab-{{ tid }}">{{ label_map[tid] }}</label>
      {% endfor %}
    </nav>

    <div class="nx-tabs__panels">
      {% if 'overview' in tab_ids %}
      <article id="nx-panel-overview" class="nx-tabs__panel">
        <div class="nx-overview__module">
          <p class="nx-section-eyebrow">About this module</p>
          {% if fragments.DESCRIPTION %}
          {{ fragments.DESCRIPTION.body }}
          {% elif fragments.CONTEXT %}
          {{ fragments.CONTEXT.body }}
          {% endif %}
        </div>
        {% if nexterp_presentation %}
        <hr class="nx-divider" />
        <div class="nx-overview__brand">
          {{ nexterp_presentation }}
        </div>
        {% endif %}
      </article>
      {% endif %}

      {% if 'features' in tab_ids %}
      <article id="nx-panel-features" class="nx-tabs__panel">
        {% if fragments.CONTEXT %}
        {% if fragments.CONTEXT.title %}<h2>{{ fragments.CONTEXT.title }}</h2>{% endif %}
        {{ fragments.CONTEXT.body }}
        {% endif %}
      </article>
      {% endif %}

      {% if 'configure' in tab_ids %}
      <article id="nx-panel-configure" class="nx-tabs__panel">
        {% if fragments.CONFIGURE.title %}<h2>{{ fragments.CONFIGURE.title }}</h2>{% endif %}
        {{ fragments.CONFIGURE.body }}
        {% if fragments.INSTALL %}
        <hr style="margin: 24px 0; border: 0; border-top: 1px solid var(--nx-border);" />
        {% if fragments.INSTALL.title %}<h3>{{ fragments.INSTALL.title }}</h3>{% endif %}
        {{ fragments.INSTALL.body }}
        {% endif %}
      </article>
      {% endif %}

      {% if 'usage' in tab_ids %}
      <article id="nx-panel-usage" class="nx-tabs__panel">
        {% if fragments.USAGE.title %}<h2>{{ fragments.USAGE.title }}</h2>{% endif %}
        {{ fragments.USAGE.body }}
      </article>
      {% endif %}

      {% if 'versions' in tab_ids %}
      <article id="nx-panel-versions" class="nx-tabs__panel nx-versions">
        {{ fragments.HISTORY.body }}
      </article>
      {% endif %}
    </div>
  </section>

  {# ===== Suite section: other modules in this repo ===== #}
  {% if siblings %}
  <section class="nx-suite">
    <h2>Discover the NextERP suite</h2>
    <p class="nx-suite__sub">Other modules from the same publisher, built to work together.</p>
    <div class="nx-suite__grid">
      {% for s in siblings %}
      <a class="nx-suite__card" href="{{ s.apps_url }}" target="_blank" rel="noopener">
        <div class="nx-suite__card-head">
          {% if s.icon %}
          <img class="nx-suite__card-icon" src="{{ s.icon }}" alt="{{ s.title }} icon" />
          {% else %}
          <div class="nx-suite__card-icon nx-suite__card-icon--placeholder">{{ s.title[:2]|upper }}</div>
          {% endif %}
          <div>
            <div class="nx-suite__card-title">{{ s.title }}</div>
            {% if s.category %}<div class="nx-suite__card-cat">{{ s.category }}</div>{% endif %}
          </div>
        </div>
        {% if s.summary %}<div class="nx-suite__card-summary">{{ s.summary }}</div>{% endif %}
      </a>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {# ===== Brand footer ===== #}
  <section class="nx-foot">
    <div>
      <h3>NextERP Romania</h3>
      <p>Odoo implementation, customization, Romanian localization and long-term support since 2014.</p>
    </div>
    <div class="nx-foot__links">
      <a href="https://www.nexterp.ro" target="_blank" rel="noopener">nexterp.ro</a>
      {% if manifest.support %}<a href="mailto:{{ manifest.support }}">{{ manifest.support }}</a>{% endif %}
      <a href="https://apps.odoo.com/apps/browse?author=NextERP+Romania" target="_blank" rel="noopener">All apps</a>
    </div>
  </section>

</div>
</body>
</html>
